# Configure these as environment variables in your local shell or hosting dashboard.
# Do not commit a real .env file or provider key.
GEMINI_API_KEY=replace_with_your_google_ai_studio_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta
GATEWAY_TOKEN=replace_with_a_long_random_secret

# Local-only gateway testing; not the organizer's op:llm controller protocol.
PARTPILOT_GATEWAY_URL=http://127.0.0.1:8080
